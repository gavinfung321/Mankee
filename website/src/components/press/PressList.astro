---
import { pressItems, visiblePressLinks } from "../../content/index.ts";

const links = visiblePressLinks(pressItems);
---

<section class="home-section press-index">
  <div class="home-inner">
    <h1>報道</h1>
    {links.length > 0 && (
      <ul class="press-list">
        {links.map((link) => (
          <li>
            <a href={link.url}>{link.title}</a>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>
