---
import { isCurrentPath, primaryNav } from "../../lib/navigation";

const pathname = Astro.url.pathname;
---

<header class="site-header">
  <a class="wordmark" href="/">
    文記車仔麵
  </a>
  <details class="nav-disclosure">
    <summary>選單</summary>
  </details>
  <ul class="nav-list">
    {primaryNav.map((item) => (
      <li>
        <a
          href={item.href}
          aria-current={isCurrentPath(item.href, pathname) ? "page" : undefined}
          class:list={[{ "nav-cta": item.id === "visit" }]}
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</header>
